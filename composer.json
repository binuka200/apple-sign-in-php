{
    "name": "binuka200/apple-sign-in",
    "description": "Defensive, framework-neutral Sign in with Apple for PHP: OAuth flow, token verification, revocation, and notifications.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/binuka200/apple-sign-in-php",
    "keywords": ["apple", "sign-in", "oauth", "oidc", "jwt"],
    "authors": [
        {
            "name": "binuka200",
            "homepage": "https://github.com/binuka200",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://github.com/binuka200/apple-sign-in-php#readme",
        "issues": "https://github.com/binuka200/apple-sign-in-php/issues",
        "source": "https://github.com/binuka200/apple-sign-in-php"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0.5",
        "psr/simple-cache": "^3.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client-contracts": "^3.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "SafeApple\\SignIn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SafeApple\\SignIn\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@php vendor/bin/phpunit --coverage-clover=.phpunit.cache/clover.xml",
            "@php tools/coverage-check.php .phpunit.cache/clover.xml 77"
        ],
        "lint": "@php tools/lint.php",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M --debug",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.phpstan.cache",
            "/.phpunit.cache",
            "/composer.lock",
            "/docs/assets",
            "/docs/medium-article.md",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/security-audit",
            "/tests",
            "/tools",
            "/vendor"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
